// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VlfReport {
  id              Int      @id @default(autoincrement())
  proyecto        String
  cliente         String
  distancia_cable Float
  resistencia     Float
  marca_cable     String
  voltaje         Int
  fecha_prueba    DateTime @default(now())
  punto_prueba    String
}
